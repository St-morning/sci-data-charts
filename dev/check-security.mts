import assert from 'node:assert/strict';
import {JSDOM} from 'jsdom';
import 'fake-indexeddb/auto';
import {IDBDatabase} from 'fake-indexeddb';
import * as XLSX from 'xlsx';
const dom=new JSDOM('<!doctype html><body></body>',{url:'https://test.invalid/'});
Object.assign(globalThis,{window:dom.window,document:dom.window.document,DOMParser:dom.window.DOMParser,XMLSerializer:dom.window.XMLSerializer,localStorage:dom.window.localStorage,Event:dom.window.Event});
const {sanitizeSvg,svgPanel}=await import('../lib/svg-safety.ts');
const bad=`<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="10 20 100 60" onload="alert(1)"><script>alert(1)</script><foreignObject><div xmlns="http://www.w3.org/1999/xhtml"><img src="x" onerror="alert(1)"/></div></foreignObject><style>@import 'https://example.com/track';</style><a href="javascript:alert(1)"><text>bad</text></a><image href="https://example.com/x.png"/><image href="data:image/svg+xml;base64,PHN2Zz4="/><use href="javascript:alert(1)"/><rect width="10" height="10" style="fill:url(https://example.com/a);stroke:#ff0000;filter:blur(2px)" fill="url(https://example.com/p)" onclick="alert(1)"/><defs><linearGradient id="safe"><stop offset="0" stop-color="#fff"/></linearGradient><clipPath id="clip"><rect width="5" height="5"/></clipPath></defs><rect width="10" height="10" fill="url(#safe)" clip-path="url(#clip)"/><use href="#clip"/></svg>`;
const safe=sanitizeSvg(bad),root=new DOMParser().parseFromString(safe,'image/svg+xml');
assert.equal(root.querySelectorAll('script,foreignObject,style,a').length,0);
assert(!/onload|onclick|onerror|javascript:|https:\/\/example\.com|data:image\/svg/i.test(safe));
assert(safe.includes('url(#safe)'));assert(safe.includes('url(#clip)'));assert(safe.includes('linearGradient'));assert(safe.includes('clipPath'));assert(safe.includes('stroke:#ff0000'));
assert.equal(svgPanel(safe).viewBox,'10 20 100 60');assert.throws(()=>sanitizeSvg('<svg><bad>'));assert.throws(()=>sanitizeSvg('<!DOCTYPE svg><svg/>'));assert.throws(()=>svgPanel('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 -1 5"/>'));
const {initializeWorkspace,loadPanels,addPanel,loadCards,saveCards}=await import('../lib/store.ts');
localStorage.setItem('scibench.storyboard.v1',JSON.stringify([{id:'legacy',section:'question',title:'旧卡片',body:'保留',createdAt:1}]));
await initializeWorkspace();assert.equal(loadCards()[0].title,'旧卡片');
const large='data:image/png;base64,'+'A'.repeat(6*1024*1024);
await addPanel({id:'large',name:'大图',kind:'image',dataUrl:large,w:10,h:10,createdAt:1});assert.equal(loadPanels()[0].dataUrl?.length,large.length);
const {openDB}=await import('idb');const db=await openDB('scibench.workspace',1);assert.equal((await db.get('values','scibench.panels.v1'))[0].id,'large');
const original=IDBDatabase.prototype.transaction;
IDBDatabase.prototype.transaction=function(){throw new DOMException('full','QuotaExceededError');};
const failed=await saveCards([{id:'unsaved',section:'question',title:'会话保留',body:'test',createdAt:2}]);assert.equal(failed.ok,false);assert(failed.message?.includes('仅暂存在当前会话'));assert.equal(loadCards()[0].id,'unsaved');
IDBDatabase.prototype.transaction=original;
assert.equal((await saveCards(loadCards())).ok,true);assert.equal((await db.get('values','scibench.storyboard.v1'))[0].id,'unsaved');
const wb=XLSX.utils.book_new();XLSX.utils.book_append_sheet(wb,XLSX.utils.aoa_to_sheet([['Group','Value'],['对照组',1],['处理组',3]]),'Data');
const bytes=XLSX.write(wb,{bookType:'xlsx',type:'array'});const {parseFile}=await import('../lib/data.ts');const table=await parseFile({name:'check.xlsx',size:bytes.byteLength,arrayBuffer:async()=>bytes} as File);assert.deepEqual(table.headers,['Group','Value']);assert.equal(table.rows[0][0],'对照组');
const {describe,welchT}=await import('../lib/stats.ts');const {generateParagraphs}=await import('../lib/textgen.ts');const a=[1,2,3,4],b=[8,9,10,11];const text=generateParagraphs({metricName:'指标',unit:'',groups:[{name:'对照组',desc:describe(a)},{name:'处理组',desc:describe(b)}],test:welchT(a,b),errorBar:'SD',removedMissing:0,outliers:0,removedOutliers:false});assert(!JSON.stringify(text).includes('组组'));
console.log('PASS: SVG allowlist/XSS, valid gradients/clipPaths, legacy migration, >5MB IndexedDB storage, quota failure/session fallback/recovery, Excel import, group names');
db.close();dom.window.close();
